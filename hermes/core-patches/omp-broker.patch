@@ -0,0 +1,67 @@
+"""Direct native Gemini image generation with broker-owned authentication."""
+
+from __future__ import annotations
+
+import base64
+import json
+
+from hermes_cli.omp_broker import bridge_result, is_broker_provider
+
+DEFAULT_MODEL = "gemini-3.1-flash-image"
+
+
+def image_config() -> dict | None:
+    from hermes_cli.config_effective import load_user_config_effective
+
+    config = load_user_config_effective().get("image_gen", {})
+    if not isinstance(config, dict) or config.get("provider") != "google-antigravity":
+        return None
+    return config
+
+
+def capabilities() -> dict:
+    config = image_config() or {}
+    return {"provider": "Google Antigravity", "model": config.get("model") or DEFAULT_MODEL,
+            "modalities": ["text", "image"], "max_reference_images": 14, "supports_upscale": False}
+
+
+def available() -> bool:
+    return image_config() is not None and is_broker_provider("google-antigravity")
+
+
+def generate(prompt: str, aspect_ratio: str = "square", *, image_url: str | None = None,
+             reference_image_urls: list | None = None, task_id: str | None = None, **_) -> str | None:
+    config = image_config()
+    if config is None:
+        return None
+    try:
+        if not is_broker_provider("google-antigravity"):
+            raise RuntimeError("image_gen.provider=google-antigravity requires omp_broker to be enabled for google-antigravity")
+        from model_tools import _run_async
+        from tools.image_source import ResolveContext, resolve_image_source
+        from agent.image_gen_provider import save_b64_image
+
+        references = [ref for ref in [image_url, *(reference_image_urls or [])] if isinstance(ref, str) and ref.strip()]
+        inputs = []
+        for ref in references:
+            resolved = _run_async(resolve_image_source(ref, ResolveContext(task_id=task_id)))
+            inputs.append(f"data:{resolved.mime};base64,{base64.b64encode(resolved.data).decode('ascii')}")
+        model = str(config.get("model") or DEFAULT_MODEL).removeprefix("google-antigravity/")
+        result = bridge_result("google-antigravity", "image", {
+            "model": model, "prompt": prompt, "reference_images": inputs,
+            "aspect_ratio": {"square": "1:1", "landscape": "16:9", "portrait": "9:16"}.get(aspect_ratio, aspect_ratio),
+            "image_size": str(config.get("image_size") or "1K"), "count": 1,
+        })
+        images = result.get("images", [])
+        if not images:
+            raise RuntimeError("Native Gemini image generation returned no image")
+        paths = []
+        for image in images:
+            extension = {"image/jpeg": "jpg", "image/webp": "webp"}.get(image["mimeType"], "png")
+            paths.append(str(save_b64_image(image["data"], prefix="gemini", extension=extension)))
+        return json.dumps({"success": True, "image": paths[0], "images": paths, "provider": "google-antigravity",
+                           "model": result.get("model") or model, "modality": "image" if inputs else "text",
+                           "text": result.get("text"), "usage": result.get("usage"), "upscaled": False})
+    except Exception as error:
+        return json.dumps({"success": False, "image": None, "provider": "google-antigravity",
+                           "error": str(error), "error_type": type(error).__name__})
