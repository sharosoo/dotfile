diff --git c/agent/omp_broker_client.py i/agent/omp_broker_client.py
new file mode 100644
index 0000000000..76c253c32b
--- /dev/null
+++ i/agent/omp_broker_client.py
@@ -0,0 +1,222 @@
+"""OpenAI-shaped Python facade; the Bun SDK sends native upstream requests."""
+
+from __future__ import annotations
+
+import asyncio
+import base64
+import json
+import threading
+from types import SimpleNamespace
+
+from openai.types.chat import ChatCompletion, ChatCompletionChunk
+
+from hermes_cli.omp_broker import BROKER_API_KEY, start_bridge, stop_bridge
+
+
+def _provider_error(error: dict) -> Exception:
+    import httpx
+    from openai import APIStatusError
+
+    status = int(error.get("status") or 500)
+    response = httpx.Response(status, request=httpx.Request("POST", "http://omp-native.invalid"))
+    return APIStatusError(error.get("message") or "Native omp inference failed", response=response, body=error)
+
+def _native_vision_messages(messages: list[dict]) -> list[dict]:
+    updated_messages = None
+    for message_index, message in enumerate(messages):
+        content = message.get("content")
+        if not isinstance(content, list):
+            continue
+        updated_content = None
+        for content_index, part in enumerate(content):
+            if not isinstance(part, dict) or part.get("type") != "image_url":
+                continue
+            image_url = part.get("image_url")
+            source = image_url.get("url") if isinstance(image_url, dict) else image_url
+            if not isinstance(source, str) or not source.lower().startswith(("http://", "https://")):
+                continue
+            from model_tools import _run_async
+            from tools.image_source import ResolveContext, resolve_image_source
+
+            scheme, rest = source.split(":", 1)
+            # Public URLs still work, but only the shared resolver may access the network or follow redirects.
+            resolved = _run_async(resolve_image_source(f"{scheme.lower()}:{rest}", ResolveContext()))
+            data_url = f"data:{resolved.mime};base64,{base64.b64encode(resolved.data).decode('ascii')}"
+            if updated_content is None:
+                updated_content = list(content)
+            updated_content[content_index] = {
+                **part, "image_url": {**image_url, "url": data_url} if isinstance(image_url, dict) else data_url,
+            }
+        if updated_content is not None:
+            if updated_messages is None:
+                updated_messages = list(messages)
+            updated_messages[message_index] = {**message, "content": updated_content}
+    return updated_messages if updated_messages is not None else messages
+
+
+
+class BrokerStream:
+    def __init__(self, provider: str, request: dict):
+        self._process = start_bridge(provider, "chat", request)
+        self._closed = False
+
+    def __iter__(self):
+        return self
+
+    def __next__(self):
+        if self._closed:
+            raise StopIteration
+        line = self._process.stdout.readline()
+        if not line:
+            code = self._process.wait()
+            self.close()
+            if code:
+                raise RuntimeError(f"Native omp inference host exited ({code})")
+            raise StopIteration
+        payload = json.loads(line)
+        if "error" in payload:
+            self.close()
+            raise _provider_error(payload["error"])
+        chunk = payload.get("chunk")
+        if chunk is None:
+            self.close()
+            raise RuntimeError("Native omp host returned an invalid stream frame")
+        return ChatCompletionChunk.model_validate({"id": "omp-native", "object": "chat.completion.chunk", "created": 0, **chunk})
+
+    def close(self):
+        if not self._closed:
+            self._closed = True
+            stop_bridge(self._process)
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, *_):
+        self.close()
+
+
+class OmpBrokerClient:
+    def __init__(self, provider: str, *, session_id: str | None = None):
+        self.provider = provider
+        self.api_key = BROKER_API_KEY
+        self.base_url = f"broker://{provider}"
+        self._hermes_aux_effective_provider = provider
+        self._session_id = session_id
+        self._streams: set[BrokerStream] = set()
+        self._processes = set()
+        self._closed = False
+        self._lock = threading.Lock()
+        self.chat = SimpleNamespace(completions=SimpleNamespace(create=self.create))
+
+    def create(self, **kwargs):
+        with self._lock:
+            if self._closed:
+                raise RuntimeError("Native omp client is closed")
+        request = {**kwargs, "session_id": kwargs.get("session_id") or self._session_id}
+        # OpenAI's timeout/retry wrappers never own the SDK host's native transport.
+        request.pop("timeout", None)
+        request.pop("extra_headers", None)
+        request.pop("extra_query", None)
+        request.pop("stream_options", None)
+        if "messages" in request:
+            request["messages"] = _native_vision_messages(request["messages"])
+        if kwargs.get("stream"):
+            stream = BrokerStream(self.provider, request)
+            with self._lock:
+                if self._closed:
+                    stream.close()
+                    raise RuntimeError("Native omp client is closed")
+                self._streams = {s for s in self._streams if not s._closed}
+                self._streams.add(stream)
+            return stream
+        process = start_bridge(self.provider, "chat", request)
+        with self._lock:
+            if self._closed:
+                stop_bridge(process)
+                raise RuntimeError("Native omp client is closed")
+            self._processes.add(process)
+        try:
+            for line in process.stdout:
+                payload = json.loads(line)
+                if "error" in payload:
+                    raise _provider_error(payload["error"])
+                if "result" in payload:
+                    return ChatCompletion.model_validate({"created": 0, **payload["result"]})
+            raise RuntimeError(f"Native omp host exited without a response ({process.wait()})")
+        finally:
+            stop_bridge(process)
+            with self._lock:
+                self._processes.discard(process)
+
+    def close(self):
+        with self._lock:
+            self._closed = True
+            processes, self._processes = self._processes, set()
+            streams, self._streams = self._streams, set()
+        for stream in streams:
+            stream.close()
+        for process in processes:
+            stop_bridge(process)
+
+    def with_options(self, **_):
+        return self
+
+
+class AsyncOmpBrokerClient:
+    def __init__(self, client: OmpBrokerClient):
+        self._client = client
+        self._active_clients: set[OmpBrokerClient] = set()
+        self._closed = False
+        self.provider, self.api_key, self.base_url = client.provider, client.api_key, client.base_url
+        self.chat = SimpleNamespace(completions=SimpleNamespace(create=self.create))
+
+    async def _close_call(self, client: OmpBrokerClient):
+        try:
+            await asyncio.to_thread(client.close)
+        finally:
+            self._active_clients.discard(client)
+
+    async def create(self, **kwargs):
+        if self._closed:
+            raise RuntimeError("Native omp client is closed")
+        call_client = OmpBrokerClient(self.provider, session_id=self._client._session_id)
+        self._active_clients.add(call_client)
+        response = None
+        try:
+            response = await asyncio.to_thread(call_client.create, **kwargs)
+            if self._closed:
+                raise RuntimeError("Native omp client is closed")
+            return AsyncBrokerStream(response, self, call_client) if isinstance(response, BrokerStream) else response
+        finally:
+            if not isinstance(response, BrokerStream) or self._closed:
+                await self._close_call(call_client)
+
+    async def close(self):
+        self._closed = True
+        await asyncio.gather(
+            *(self._close_call(client) for client in list(self._active_clients)),
+            asyncio.to_thread(self._client.close),
+        )
+
+
+class AsyncBrokerStream:
+    def __init__(self, stream: BrokerStream, owner: AsyncOmpBrokerClient, client: OmpBrokerClient):
+        self._stream, self._owner, self._client = stream, owner, client
+
+    def __aiter__(self):
+        return self
+
+    async def __anext__(self):
+        sentinel = object()
+        try:
+            chunk = await asyncio.to_thread(next, self._stream, sentinel)
+        except BaseException:
+            await self.close()
+            raise
+        if chunk is sentinel:
+            await self.close()
+            raise StopAsyncIteration
+        return chunk
+
+    async def close(self):
+        await self._owner._close_call(self._client)
