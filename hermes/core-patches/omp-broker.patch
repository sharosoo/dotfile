+"""Request hosts handle image-size JSON frames and enforce the image deadline."""
+
+import os
+import sys
+from types import SimpleNamespace
+
+import pytest
+
+from hermes_cli import omp_broker
+
+
+@pytest.fixture
+def request_host(monkeypatch, tmp_path):
+    runtime = tmp_path / "omp-broker-runtime"
+    runtime.mkdir()
+    (runtime / "bridge.ts").touch()
+    processes = []
+    monkeypatch.setattr(omp_broker, "get_default_hermes_root", lambda **_: tmp_path)
+    monkeypatch.setattr(omp_broker, "get_hermes_home", lambda: tmp_path)
+    monkeypatch.setattr(omp_broker, "broker_config", lambda: {
+        "url": "http://127.0.0.1:8765", "token_file": str(tmp_path / "broker.token"),
+        "providers": ["google-antigravity"],
+    })
+    monkeypatch.setattr("tools.environments.local.served_profile_child_env", lambda **_: dict(os.environ))
+    real_popen = omp_broker.subprocess.Popen
+
+    def launch(*args, **kwargs):
+        process = real_popen(*args, **kwargs)
+        processes.append(process)
+        return process
+
+    monkeypatch.setattr(omp_broker.subprocess, "Popen", launch)
+
+    def install(script):
+        monkeypatch.setattr("hermes_platform.resolver.locate_command", lambda _: SimpleNamespace(
+            found=True, command=(sys.executable, "-u", "-c", script),
+        ))
+        return processes
+
+    yield install
+    for process in processes:
+        if process.poll() is None:
+            process.terminate()
+            process.wait(timeout=5)
+        if process.stdout:
+            process.stdout.close()
+
+
+def test_large_image_request_and_response_cross_host_without_pipe_deadlock(request_host):
+    processes = request_host(
+        "import json,sys\n"
+        "request=json.load(sys.stdin)\n"
+        "reference=request['request']['reference_images'][0]\n"
+        "print(json.dumps({'result':{'image':reference}}),flush=True)\n"
+    )
+    reference = "data:image/jpeg;base64," + "A" * (640 * 1024)
+    result = omp_broker.bridge_result("google-antigravity", "image", {"reference_images": [reference]})
+    assert result["image"] == reference
+    assert processes[0].poll() is not None
+
+
+def test_incomplete_image_response_cannot_block_deadline(request_host, monkeypatch):
+    processes = request_host(
+        "import json,sys,time\n"
+        "json.load(sys.stdin)\n"
+        "sys.stdout.write('{\"result\":{\"image\":\"'+'A'*100000)\n"
+        "sys.stdout.flush()\n"
+        "time.sleep(60)\n"
+    )
+    monkeypatch.setattr(omp_broker, "IMAGE_TIMEOUT_SECONDS", 2.0)
+    with pytest.raises(TimeoutError, match="Native image generation timed out"):
+        omp_broker.bridge_result("google-antigravity", "image", {"prompt": "deadline-test"})
+    assert processes[0].poll() is not None
