diff --git c/hermes_cli/omp_broker.py i/hermes_cli/omp_broker.py
new file mode 100644
index 0000000000..531ed870f2
--- /dev/null
+++ i/hermes_cli/omp_broker.py
@@ -0,0 +1,167 @@
+"""Profile-scoped access to the direct omp native SDK host."""
+
+from __future__ import annotations
+
+import json
+import os
+import subprocess
+from pathlib import Path
+from typing import Any
+import threading
+import time
+import selectors
+import tempfile
+from urllib.parse import urlparse
+
+from hermes_constants import get_default_hermes_root, get_hermes_home
+
+BROKER_PROVIDERS = ("anthropic", "openai-codex", "google-antigravity", "devin", "commandcode")
+BROKER_API_KEY = "omp-broker-managed"
+IMAGE_TIMEOUT_SECONDS = 240.0
+
+_catalog_lock = threading.Lock()
+_catalog_cache: dict[tuple, tuple[float, list[dict]]] = {}
+
+def broker_config() -> dict[str, Any]:
+    from hermes_cli.config_effective import load_user_config_effective
+
+    raw = load_user_config_effective().get("omp_broker", {})
+    if not isinstance(raw, dict) or raw.get("enabled") is not True:
+        return {}
+    url = str(raw.get("url") or "http://127.0.0.1:8765").rstrip("/")
+    parsed = urlparse(url)
+    if parsed.scheme not in {"http", "https"} or not parsed.hostname or parsed.username or parsed.password:
+        raise ValueError("omp_broker.url must be an HTTP(S) broker URL without embedded credentials")
+    providers = raw.get("providers", list(BROKER_PROVIDERS))
+    if not isinstance(providers, list) or any(p not in BROKER_PROVIDERS for p in providers):
+        raise ValueError("omp_broker.providers contains an unsupported native provider")
+    return {"url": url, "token_file": str(Path(raw.get("token_file") or "~/.omp/auth-broker.token").expanduser()), "providers": list(dict.fromkeys(providers))}
+
+
+def broker_provider_ids() -> list[str]:
+    return broker_config().get("providers", [])
+
+
+def is_broker_provider(provider: str) -> bool:
+    return provider.strip().lower() in broker_provider_ids()
+
+
+def require_broker_provider(provider: str) -> bool:
+    config = broker_config()
+    if not config:
+        return False
+    if str(provider or "").strip().lower() not in config["providers"]:
+        raise RuntimeError(
+            f"omp_broker is enabled; provider '{provider}' is not registered. "
+            f"Select one of: {', '.join(config['providers'])}"
+        )
+    return True
+
+
+def start_bridge(provider: str, action: str, request: dict | None = None) -> subprocess.Popen:
+    from hermes_platform.resolver import locate_command
+    from tools.environments.local import served_profile_child_env
+
+    config = broker_config()
+    if provider not in config.get("providers", []):
+        raise RuntimeError(f"omp broker is not enabled for {provider}")
+    bridge = get_default_hermes_root(home=get_hermes_home()) / "omp-broker-runtime" / "bridge.ts"
+    if not bridge.is_file():
+        raise RuntimeError(f"Native omp runtime is missing: {bridge}")
+    bun = locate_command("bun")
+    if not bun.found:
+        raise RuntimeError("Bun is required by the native omp runtime")
+    profile_env = served_profile_child_env(target_home=get_hermes_home(), inherit_credentials=False)
+    # The SDK auth cascade has env fallbacks; this host receives no provider credentials from the shell.
+    allowed_env = {"PATH", "HOME", "TMPDIR", "LANG", "LC_ALL", "XDG_CONFIG_HOME", "XDG_CACHE_HOME", "XDG_DATA_HOME", "HERMES_HOME"}
+    env = {k: v for k, v in profile_env.items() if k in allowed_env}
+    timeout_ms = int(IMAGE_TIMEOUT_SECONDS * 1000) if action == "image" else 0
+    # An anonymous request file avoids pipe backpressure before the parent can start reading replies.
+    with tempfile.TemporaryFile(mode="w+", encoding="utf-8") as input_file:
+        json.dump({"provider": provider, "action": action, "broker": config, "request": request or {}}, input_file)
+        input_file.flush()
+        input_file.seek(0)
+        return subprocess.Popen(
+            [*bun.command, str(bridge), str(os.getpid()), str(timeout_ms)],
+            stdin=input_file, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
+            text=True, encoding="utf-8", env=env,
+        )
+
+
+def stop_bridge(process: subprocess.Popen) -> None:
+    if process.poll() is None:
+        process.terminate()
+        try:
+            process.wait(timeout=2)
+        except subprocess.TimeoutExpired:
+            process.kill()
+            process.wait()
+    if process.stdout:
+        process.stdout.close()
+
+
+def bridge_result(provider: str, action: str, request: dict | None = None) -> Any:
+    deadline = time.monotonic() + IMAGE_TIMEOUT_SECONDS if action == "image" else None
+    process = start_bridge(provider, action, request)
+    buffer = bytearray()
+    try:
+        with selectors.DefaultSelector() as selector:
+            selector.register(process.stdout, selectors.EVENT_READ)
+            while True:
+                if action == "image":
+                    from tools.interrupt import is_interrupted
+                    if is_interrupted():
+                        raise RuntimeError("Image generation interrupted")
+                if deadline is not None and time.monotonic() >= deadline:
+                    raise TimeoutError(f"Native image generation timed out ({IMAGE_TIMEOUT_SECONDS:g}s)")
+                if not selector.select(timeout=0.25):
+                    continue
+                # TextIO.readline can block beyond the deadline on an incomplete large JSON frame.
+                chunk = os.read(process.stdout.fileno(), 64 * 1024)
+                if chunk:
+                    newline = chunk.find(b"\n")
+                    if newline < 0:
+                        buffer.extend(chunk)
+                        continue
+                    buffer.extend(chunk[:newline])
+                elif not buffer:
+                    raise RuntimeError(f"Native omp host exited without a result ({process.wait()})")
+                payload = json.loads(buffer)
+                if "error" in payload:
+                    error = payload["error"]
+                    if error.get("status") == 504:
+                        raise TimeoutError(error["message"])
+                    raise RuntimeError(error["message"])
+                if "result" in payload:
+                    return payload["result"]
+                raise RuntimeError("Native omp host returned an invalid result frame")
+    finally:
+        stop_bridge(process)
+
+
+def broker_model_catalog(provider: str) -> list[dict]:
+    config = broker_config()
+    if provider not in config.get("providers", []):
+        return []
+    key = (str(get_hermes_home()), provider, config["url"], config["token_file"])
+    with _catalog_lock:
+        cached = _catalog_cache.get(key)
+        if cached is not None and time.monotonic() - cached[0] < 30:
+            return [dict(row) for row in cached[1]]
+    rows = bridge_result(provider, "catalog")
+    with _catalog_lock:
+        _catalog_cache[key] = (time.monotonic(), rows)
+    return [dict(row) for row in rows]
+
+
+def broker_auth_status(provider: str) -> dict:
+    try:
+        return bridge_result(provider, "status")
+    except (OSError, RuntimeError) as error:
+        return {"logged_in": False, "auth_type": "omp_broker", "source": "omp-auth-broker", "error": str(error)}
+
+
+def broker_runtime(provider: str, requested_provider: str | None = None) -> dict:
+    return {"provider": provider, "requested_provider": requested_provider or provider,
+            "api_mode": "chat_completions", "base_url": f"broker://{provider}",
+            "api_key": BROKER_API_KEY, "source": "omp-auth-broker"}
