diff --git c/hermes_cli/model_visibility.py i/hermes_cli/model_visibility.py
new file mode 100644
index 0000000000..ca389aa172
--- /dev/null
+++ i/hermes_cli/model_visibility.py
@@ -0,0 +1,214 @@
+"""Opt-in model-list visibility; explicit inference and stored defaults are unchanged."""
+
+from __future__ import annotations
+
+from calendar import monthrange
+from dataclasses import dataclass
+from datetime import date, datetime, timezone
+from typing import Any
+
+
+# These providers expose the same vendor models through a different authentication route.
+_CATALOG_PROVIDERS = {
+    "google-antigravity": "google", "gemini": "google", "z-ai": "zai", "zai-org": "zai",
+    "minimaxai": "minimax", "qwen": "alibaba", "mimo": "xiaomi", "glm": "zai", "kimi": "moonshotai",
+}
+_MODEL_ALIASES = {
+    ("anthropic", "claude-fable-5.1"): "claude-fable-5-1",
+    # The vendor catalog calls this wire model DeepSeek V4.1 Flash under the deepseek-flash key.
+    ("deepseek", "deepseek-v4.1-flash"): "deepseek-flash",
+}
+_VENDOR_RELEASES = {
+    ("devin", "swe-2"): ("2026-09-10", "https://cognition.com/blog/swe-2"),
+    ("devin", "swe-1-7"): ("2026-07-08", "https://cognition.com/blog/swe-1-7"),
+    ("devin", "swe-1-7-lightning"): ("2026-07-08", "https://cognition.com/blog/swe-1-7"),
+}
+
+
+def _config() -> dict:
+    from hermes_cli.config import load_config_readonly
+
+    return load_config_readonly()
+
+
+def configured_broker_provider_ids(*, config: dict | None = None) -> list[str] | None:
+    """None means native listing; an enabled broker owns the entire provider picker."""
+    cfg = _config() if config is None else config
+    block = cfg.get("omp_broker") or {}
+    if not isinstance(block, dict) or block.get("enabled") is not True:
+        return None
+    from hermes_cli.omp_broker import broker_provider_ids
+
+    return broker_provider_ids()
+
+
+def _release_date(value: Any) -> date | None:
+    if isinstance(value, datetime):
+        return value.date()
+    if isinstance(value, date):
+        return value
+    if not isinstance(value, str):
+        return None
+    try:
+        return date.fromisoformat(value)
+    except ValueError:
+        try:
+            return datetime.fromisoformat(value.replace("Z", "+00:00")).date()
+        except ValueError:
+            return None
+
+
+@dataclass(frozen=True)
+class ModelVisibility:
+    max_age_months: int = 0
+    hide_unknown: bool = True
+
+    @classmethod
+    def from_config(cls, config: dict) -> "ModelVisibility":
+        block = config.get("model_visibility") or {}
+        if not isinstance(block, dict):
+            raise ValueError("model_visibility must be a mapping")
+        months = block.get("max_age_months", 0)
+        if isinstance(months, bool) or not isinstance(months, int) or months < 0:
+            raise ValueError("model_visibility.max_age_months must be a non-negative integer")
+        hide_unknown = block.get("hide_unknown", True)
+        if not isinstance(hide_unknown, bool):
+            raise ValueError("model_visibility.hide_unknown must be a boolean")
+        return cls(months, hide_unknown)
+
+    def cutoff(self, today: date) -> date:
+        month_index = today.year * 12 + today.month - 1 - self.max_age_months
+        year, month = divmod(month_index, 12)
+        month += 1
+        return date(year, month, min(today.day, monthrange(year, month)[1]))
+
+    def allows(self, released: date | None, *, today: date | None = None) -> bool:
+        if not self.max_age_months:
+            return True
+        if released is None:
+            return not self.hide_unknown
+        today = today or date.today()
+        return self.cutoff(today) <= released <= today
+
+
+def _model_id(item: Any) -> str:
+    if isinstance(item, dict):
+        return str(item.get("id") or "")
+    if isinstance(item, tuple):
+        return str(item[0]) if item else ""
+    return str(item or "")
+
+
+def model_release_metadata(
+    provider: str, model_id: str, *, metadata: dict | None = None, config: dict | None = None,
+) -> tuple[date | None, str]:
+    """Only release metadata is trusted: never cache age, name dates or generic API creation times."""
+    metadata = metadata or {}
+    for key in ("release_date", "releaseDate"):
+        if metadata.get(key):
+            return _release_date(metadata[key]), str(metadata.get("release_date_source") or "provider catalog")
+    # A catalog adapter must validate this field's meaning against its vendor documentation first.
+    if metadata.get("created_at_is_release_date") is True and metadata.get("release_date_source"):
+        raw = metadata.get("created_at")
+        try:
+            if isinstance(raw, (int, float)) and not isinstance(raw, bool):
+                released = datetime.fromtimestamp(raw, timezone.utc).date()
+            else:
+                released = datetime.fromisoformat(str(raw).replace("Z", "+00:00")).date()
+        except (OverflowError, OSError, TypeError, ValueError):
+            released = None
+        return released, str(metadata["release_date_source"])
+
+    provider = str(provider or "").strip().lower()
+    model_id = str(model_id or "").strip()
+    vendor_date = _VENDOR_RELEASES.get((provider, model_id))
+    if vendor_date is not None:
+        return _release_date(vendor_date[0]), vendor_date[1]
+
+    from agent.models_dev import get_model_info
+
+    catalog_provider = _CATALOG_PROVIDERS.get(provider, provider)
+    identity = metadata.get("identity") or {}
+    if provider in {"commandcode", "google-antigravity", "devin"} and isinstance(identity, dict):
+        vendor = str(identity.get("class") or "").lower()
+        if vendor and vendor != "unknown":
+            catalog_provider = _CATALOG_PROVIDERS.get(vendor, vendor)
+    if provider == "openai-codex":
+        from agent.model_metadata import strip_codex_context_variant_suffix
+
+        model_id = strip_codex_context_variant_suffix(model_id)
+    # A reseller's qualified id identifies the original lab, not a new release of its own.
+    if "/" in model_id:
+        vendor, bare_id = model_id.split("/", 1)
+        if provider in {"commandcode", "google-antigravity", "devin", "anthropic", "openai-codex"}:
+            catalog_provider = _CATALOG_PROVIDERS.get(vendor.lower(), vendor.lower())
+            model_id = bare_id
+    model_id = _MODEL_ALIASES.get((catalog_provider, model_id.lower()), model_id)
+    info = get_model_info(catalog_provider, model_id, allow_network=False, config=config)
+    if info is None or not info.release_date:
+        return None, ""
+    return _release_date(info.release_date), f"https://models.dev/api.json#{info.provider_id}/{info.id}"
+
+
+def visible_models(
+    provider: str, models: Any, *, catalog: list[dict] | None = None, config: dict | None = None,
+    today: date | None = None,
+):
+    """Filter string, tuple or metadata-row lists without losing catalog list subclasses."""
+    if models is None:
+        return None
+    cfg = _config() if config is None else config
+    policy = ModelVisibility.from_config(cfg)
+    if not policy.max_age_months:
+        return models
+    if catalog is None and any(not isinstance(item, dict) for item in models):
+        broker_ids = configured_broker_provider_ids(config=cfg)
+        if broker_ids is not None and provider in broker_ids:
+            from hermes_cli.omp_broker import broker_model_catalog
+
+            catalog = broker_model_catalog(provider)
+    metadata_by_id = {_model_id(row): row for row in (catalog or [])}
+    kept = []
+    for item in models:
+        model_id = _model_id(item)
+        metadata = metadata_by_id.get(model_id)
+        if isinstance(item, dict):
+            metadata = {**(metadata or {}), **item}
+        released, _source = model_release_metadata(provider, model_id, metadata=metadata, config=cfg)
+        if policy.allows(released, today=today):
+            kept.append(item)
+    return type(models)(kept)
+
+
+def visible_model_catalog(provider: str, catalog: dict, *, config: dict | None = None) -> dict:
+    rows = [{**metadata, "id": model_id} for model_id, metadata in catalog.items()]
+    visible = visible_models(provider, rows, config=config)
+    return {row["id"]: catalog[row["id"]] for row in visible}
+
+
+def visible_provider_rows(rows: list[dict], *, config: dict | None = None) -> list[dict]:
+    """Apply after current-model/skeleton injections so those cannot bypass visibility."""
+    cfg = _config() if config is None else config
+    broker_ids = configured_broker_provider_ids(config=cfg)
+    policy = ModelVisibility.from_config(cfg)
+    if broker_ids is not None:
+        rows = [row for row in rows if row.get("slug") in broker_ids]
+    if not policy.max_age_months:
+        return rows
+    result = []
+    for row in rows:
+        provider = str(row.get("slug") or "")
+        models = row.get("models") or []
+        filtered = visible_models(provider, models, catalog=row.get("model_metadata"), config=cfg)
+        updated = {**row, "models": filtered}
+        updated["total_models"] = max(0, row.get("total_models", len(models)) - (len(models) - len(filtered)))
+        for field in ("featured_models", "unavailable_models"):
+            if isinstance(row.get(field), list):
+                updated[field] = visible_models(provider, row[field], catalog=row.get("model_metadata"), config=cfg)
+        for field in ("pricing", "model_pricing", "capabilities", "aliases"):
+            if isinstance(row.get(field), dict):
+                updated[field] = {mid: value for mid, value in row[field].items() if mid in filtered}
+        if isinstance(row.get("model_metadata"), list):
+            updated["model_metadata"] = visible_models(provider, row["model_metadata"], config=cfg)
+        result.append(updated)
+    return result
