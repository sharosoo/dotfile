+"""Native vision uses Hermes's network boundary; async clients own real request hosts."""
+
+import asyncio
+import base64
+import json
+import subprocess
+import sys
+
+import httpx
+import pytest
+
+from agent import omp_broker_client as broker
+from tools.image_source import SourceUnsafe
+
+
+PNG = base64.b64decode(
+    "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII="
+)
+
+
+def _vision_messages(url):
+    return [{"role": "user", "content": [{"type": "image_url", "image_url": {"url": url, "detail": "high"}}]}]
+
+
+def _http_transport(monkeypatch, handler):
+    monkeypatch.setattr("tools.website_policy.check_website_access", lambda _: None)
+    monkeypatch.setattr("tools.vision_tools.check_website_access", lambda _: None)
+    monkeypatch.setattr(
+        "tools.url_safety.create_ssrf_safe_async_client",
+        lambda **kwargs: httpx.AsyncClient(transport=httpx.MockTransport(handler), **kwargs),
+    )
+
+
+@pytest.mark.parametrize("url", [
+    "http://127.0.0.1/image.png", "http://10.0.0.1/image.png",
+    "http://169.254.169.254/image.png", "http://[::1]/image.png",
+])
+def test_private_vision_url_is_rejected_before_native_host(monkeypatch, url):
+    def unexpected_host(*_):
+        pytest.fail("A rejected image must not launch a native host")
+
+    monkeypatch.setattr(broker, "start_bridge", unexpected_host)
+    with pytest.raises(SourceUnsafe, match="unsafe or private"):
+        broker.OmpBrokerClient("google-antigravity").chat.completions.create(
+            model="vision-test", messages=_vision_messages(url), stream=True,
+        )
+
+
+def test_public_vision_redirect_resolves_to_data_without_mutating_history(monkeypatch):
+    requests = []
+
+    def handler(request):
+        requests.append(str(request.url))
+        if request.url.host == "8.8.8.8":
+            return httpx.Response(302, headers={"location": "https://8.8.4.4/image.png"})
+        return httpx.Response(200, content=PNG, headers={"content-type": "image/png"})
+
+    _http_transport(monkeypatch, handler)
+    original = _vision_messages("https://8.8.8.8/source")
+    resolved = broker._native_vision_messages(original)
+    result = resolved[0]["content"][0]["image_url"]
+    assert result["url"] == "data:image/png;base64," + base64.b64encode(PNG).decode("ascii")
+    assert result["detail"] == "high"
+    assert original[0]["content"][0]["image_url"]["url"] == "https://8.8.8.8/source"
+    assert requests == ["https://8.8.8.8/source", "https://8.8.4.4/image.png"]
+
+
+def test_vision_redirect_to_private_address_is_not_fetched(monkeypatch):
+    requests = []
+
+    def handler(request):
+        requests.append(str(request.url))
+        return httpx.Response(302, headers={"location": "http://127.0.0.1/private.png"})
+
+    _http_transport(monkeypatch, handler)
+    with pytest.raises(ValueError, match="Blocked redirect"):
+        broker._native_vision_messages(_vision_messages("https://8.8.8.8/source"))
+    assert requests == ["https://8.8.8.8/source"]
+
+
+@pytest.fixture
+def native_hosts(monkeypatch):
+    processes = []
+    frame = json.dumps({"chunk": {"model": "stream-test", "choices": [
+        {"index": 0, "delta": {"content": "started"}},
+    ]}})
+    script = f"import time\nprint({frame!r}, flush=True)\ntime.sleep(60)\n"
+
+    def launch(*_):
+        process = subprocess.Popen(
+            [sys.executable, "-u", "-c", script], stdout=subprocess.PIPE,
+            text=True, encoding="utf-8",
+        )
+        processes.append(process)
+        return process
+
+    monkeypatch.setattr(broker, "start_bridge", launch)
+    yield processes
+    for process in processes:
+        if process.poll() is None:
+            process.terminate()
+            process.wait(timeout=5)
+        process.stdout.close()
+
+
+@pytest.mark.asyncio
+async def test_async_client_close_stops_returned_stream_host(native_hosts):
+    client = broker.AsyncOmpBrokerClient(broker.OmpBrokerClient("anthropic"))
+    stream = await client.chat.completions.create(model="stream-test", messages=[], stream=True)
+    assert (await stream.__anext__()).choices[0].delta.content == "started"
+    assert native_hosts[0].poll() is None
+    await client.close()
+    assert native_hosts[0].poll() is not None
+    with pytest.raises(StopAsyncIteration):
+        await stream.__anext__()
+
+
+@pytest.mark.asyncio
+async def test_canceling_one_async_stream_does_not_stop_another(native_hosts):
+    client = broker.AsyncOmpBrokerClient(broker.OmpBrokerClient("anthropic"))
+    first = await client.chat.completions.create(model="stream-test", messages=[], stream=True)
+    second = await client.chat.completions.create(model="stream-test", messages=[], stream=True)
+    await first.__anext__()
+    await second.__anext__()
+    pending = asyncio.create_task(first.__anext__())
+    await asyncio.sleep(0)
+    pending.cancel()
+    with pytest.raises(asyncio.CancelledError):
+        await pending
+    assert native_hosts[0].poll() is not None
+    assert native_hosts[1].poll() is None
+    await client.close()
+    assert native_hosts[1].poll() is not None
+
+
+@pytest.fixture
+def exclusive_broker_config(monkeypatch):
+    settings = {"enabled": True, "providers": ["anthropic"]}
+    monkeypatch.setattr(
+        "hermes_cli.config_effective.load_user_config_effective",
+        lambda: {"omp_broker": settings},
+    )
+    return settings
+
+
+def test_enabled_broker_rejects_legacy_explicit_runtime(exclusive_broker_config):
+    from hermes_cli.runtime_provider import resolve_runtime_provider
+
+    with pytest.raises(RuntimeError, match="omp_broker is enabled.*openai"):
+        resolve_runtime_provider(
+            requested="openai", explicit_api_key="unused-test-key",
+            explicit_base_url="http://127.0.0.1:4000/v1", target_model="route-test",
+        )
+
+
+def test_enabled_broker_rejects_legacy_auxiliary_route(exclusive_broker_config):
+    from agent.auxiliary_client import resolve_provider_client
+
+    with pytest.raises(RuntimeError, match="omp_broker is enabled.*openai"):
+        resolve_provider_client(
+            "openai", model="route-test", explicit_api_key="unused-test-key",
+            explicit_base_url="http://127.0.0.1:4000/v1",
+        )
+
+
+def test_auto_auxiliary_route_uses_native_main_identity(exclusive_broker_config):
+    from agent.auxiliary_client import _get_cached_client
+
+    client, model = _get_cached_client(
+        "auto", main_runtime={"provider": "anthropic", "model": "route-test"},
+        base_url="http://127.0.0.1:4000/v1", api_key="unused-test-key",
+    )
+    assert client.base_url == "broker://anthropic"
+    assert model == "route-test"
+    client.close()
+
+
+def test_broker_failure_cannot_enter_legacy_auxiliary_recovery(exclusive_broker_config):
+    from agent.auxiliary_client import _aux_recovery_ladder
+
+    failure = RuntimeError("omp auth-broker is unavailable")
+    recovery = _aux_recovery_ladder(
+        failure, client=None, kwargs={}, task="summarization", async_mode=False,
+        base_info="broker://anthropic", resolved_provider="anthropic", resolved_model="route-test",
+        resolved_base_url=None, resolved_api_key=None, resolved_api_mode="chat_completions",
+        final_model="route-test", max_tokens=128, main_runtime=None, route_info=None,
+    )
+    with pytest.raises(RuntimeError) as caught:
+        next(recovery)
+    assert caught.value is failure
+
+
+def test_disabled_broker_does_not_restrict_upstream_providers(exclusive_broker_config):
+    from hermes_cli.omp_broker import require_broker_provider
+
+    exclusive_broker_config["enabled"] = False
+    assert require_broker_provider("openai") is False
