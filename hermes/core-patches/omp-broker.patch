+"""Release-date visibility never becomes an inference allowlist."""
+
+from datetime import date
+import json
+import time
+
+import pytest
+
+from hermes_cli import model_visibility
+
+
+@pytest.fixture
+def catalog_home(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    (tmp_path / "config.yaml").write_text(
+        "model_visibility:\n  max_age_months: 4\n  hide_unknown: true\n",
+        encoding="utf-8",
+    )
+
+    class Today(date):
+        @classmethod
+        def today(cls):
