#!/usr/bin/env python3
"""Local credentials, TOTP and saved browser sessions for coding agents.

Secrets live in the GNOME keyring (libsecret, unlocked at login), never in files
or dotfiles. Which site/field an agent may read is decided by policy.toml
(hand-written defaults) plus sites.toml (written by `browser-vault add`).
A site can hold several accounts, addressed as SITE:ACCOUNT (e.g. google:work);
plain SITE means its only account, or "default" when none is stored yet.
Session files are Playwright-style storageState JSON written by omp's
`tab.saveState(path)` and restored with `tab.loadState(path)`.
"""

import argparse
import base64
import getpass
import hashlib
import hmac
import json
import os
import re
import struct
import subprocess
import sys
import time
import tomllib
from pathlib import Path
from urllib.parse import parse_qs, unquote, urlparse

SERVICE = "sharosoo-browser"
CONFIG_DIR = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "sharosoo-browser"
DATA_DIR = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share")) / "sharosoo-browser"
POLICY_PATH = Path(os.environ.get("BROWSER_VAULT_POLICY", CONFIG_DIR / "policy.toml"))
SITES_PATH = Path(os.environ.get("BROWSER_VAULT_SITES", CONFIG_DIR / "sites.toml"))
SESSION_DIR = DATA_DIR / "sessions"
# No '.' or ':' so "SITE:ACCOUNT" refs and "SITE.ACCOUNT.json" session names stay unambiguous.
NAME = re.compile(r"^[a-z0-9][a-z0-9_-]*$")
DEFAULT_ACCOUNT = "default"
DEFAULT_FIELDS = ["username", "password"]
TOTP_FIELD = "totp"

EXIT_DENIED = 4
EXIT_CONFIRM = 3


def die(msg, code=1):
    print(f"browser-vault: {msg}", file=sys.stderr)
    sys.exit(code)


# --- policy -------------------------------------------------------------------

def read_toml(path):
    if not path.exists():
        return {}
    with path.open("rb") as f:
        return tomllib.load(f)


def load_policy():
    if not POLICY_PATH.exists():
        die(f"policy file missing: {POLICY_PATH} (run dotfile/browser/install.sh)")
    policy = read_toml(POLICY_PATH)
    policy.setdefault("defaults", {})
    policy.setdefault("sites", {})
    managed = read_toml(SITES_PATH).get("sites", {})
    clash = set(managed) & set(policy["sites"])
    if clash:
        die(f"site(s) defined in both {POLICY_PATH} and {SITES_PATH}: {', '.join(sorted(clash))}")
    policy["sites"].update(managed)
    return policy


def site_policy(policy, site):
    if site not in policy["sites"]:
        die(f"site '{site}' is not registered; run: browser-vault add {site} --domain <host>", EXIT_DENIED)
    merged = dict(policy["defaults"])
    merged.update(policy["sites"][site])
    for key, default in (("fields", []), ("otp", False), ("session", False), ("confirm", []), ("deny", [])):
        merged.setdefault(key, default)
    return merged


def toml_value(v):
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, int):
        return str(v)
    if isinstance(v, list):
        return "[" + ", ".join(toml_value(x) for x in v) + "]"
    # JSON string escapes (\", \\, \uXXXX) are valid TOML basic-string escapes.
    return json.dumps(str(v), ensure_ascii=False)


def write_sites(sites):
    lines = ["# Generated by `browser-vault add` / `browser-vault forget`. Edit with the CLI;",
             "# hand-written defaults and comments belong in policy.toml.", ""]
    for name in sorted(sites):
        lines.append(f"[sites.{name}]")
        lines += [f"{k} = {toml_value(v)}" for k, v in sites[name].items()]
        lines.append("")
    # Write through the symlink so the dotfile copy is what changes.
    target = SITES_PATH.resolve()
    tmp = target.with_suffix(".tmp")
    tmp.write_text("\n".join(lines), encoding="utf-8")
    tmp.replace(target)


# --- keyring ------------------------------------------------------------------

def keyring(*args, stdin=None):
    try:
        return subprocess.run(["secret-tool", *args], input=stdin, capture_output=True, text=True)
    except FileNotFoundError:
        die("secret-tool not found (install libsecret)")


def attrs(site, account, field):
    return ["service", SERVICE, "site", site, "account", account, "field", field]


def stored_items():
    """(site, account, field) for every stored secret.

    Attributes go to stderr while item headers, labels and secrets go to stdout, so
    blocks cannot be reassembled; the label written by store_field
    ("<service> <site> <account> <field>") identifies an item. Secret lines are read
    but never kept.
    """
    res = subprocess.run(["secret-tool", "search", "--all", "service", SERVICE],
                         stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
    found = set()
    for line in res.stdout.splitlines():
        if not line.startswith("label = "):
            continue
        parts = line.removeprefix("label = ").split(" ")
        if len(parts) == 4 and parts[0] == SERVICE:
            found.add(tuple(parts[1:]))
    return sorted(found)


def lookup(site, account, field):
    res = keyring("lookup", *attrs(site, account, field))
    if res.returncode != 0 or not res.stdout:
        die(f"no secret stored for {site}:{account}/{field}; run: browser-vault set {site}:{account} {field}")
    return res.stdout


def store_field(site, account, field, value):
    if field == TOTP_FIELD:
        try:
            totp(value)
        except Exception as e:  # noqa: BLE001 - any parse failure means a bad seed
            die(f"invalid TOTP seed or otpauth URI: {e}")
    res = keyring("store", f"--label={SERVICE} {site} {account} {field}", *attrs(site, account, field), stdin=value)
    if res.returncode != 0:
        die(res.stderr.strip() or "secret-tool store failed")
    print(f"stored {site}:{account}/{field}", file=sys.stderr)


# --- accounts -----------------------------------------------------------------

def session_path(site, account):
    return SESSION_DIR / f"{site}.{account}.json"


def accounts_of(site, items=None):
    found = {a for s, a, _ in (items if items is not None else stored_items()) if s == site}
    if SESSION_DIR.is_dir():
        found |= {p.name.split(".")[1] for p in SESSION_DIR.glob(f"{site}.*.json")}
    return sorted(found)


def parse_ref(ref):
    site, _, account = ref.partition(":")
    if not NAME.match(site) or (account and not NAME.match(account)):
        die(f"bad reference '{ref}': use SITE or SITE:ACCOUNT (lowercase letters, digits, '-', '_')")
    return site, account or None


def resolve(ref):
    """SITE[:ACCOUNT] -> (site, account). A bare site resolves to its only account."""
    site, account = parse_ref(ref)
    if account:
        return site, account
    accounts = accounts_of(site)
    if len(accounts) > 1:
        die(f"site '{site}' has several accounts ({', '.join(accounts)}); use {site}:<account>")
    return site, accounts[0] if accounts else DEFAULT_ACCOUNT


# --- TOTP ---------------------------------------------------------------------

def parse_totp(raw):
    raw = raw.strip()
    params = {"digits": 6, "period": 30, "algorithm": "SHA1"}
    if raw.startswith("otpauth://"):
        q = parse_qs(urlparse(raw).query)
        secret = q["secret"][0]
        for key in ("digits", "period"):
            if key in q:
                params[key] = int(q[key][0])
        if "algorithm" in q:
            params["algorithm"] = q["algorithm"][0].upper()
    else:
        secret = raw
    secret = unquote(secret).replace(" ", "").upper()
    secret += "=" * (-len(secret) % 8)
    return base64.b32decode(secret), params


def totp(raw, now=None):
    key, p = parse_totp(raw)
    now = now if now is not None else time.time()
    counter = int(now // p["period"])
    digest = hmac.new(key, struct.pack(">Q", counter), getattr(hashlib, p["algorithm"].lower())).digest()
    offset = digest[-1] & 0x0F
    code = (struct.unpack(">I", digest[offset:offset + 4])[0] & 0x7FFFFFFF) % 10 ** p["digits"]
    remaining = p["period"] - int(now) % p["period"]
    return str(code).zfill(p["digits"]), remaining


# --- commands -----------------------------------------------------------------

def session_info(site, account, ttl_days):
    path = session_path(site, account)
    info = {"site": site, "account": account, "path": str(path), "exists": path.exists()}
    if path.exists():
        age = (time.time() - path.stat().st_mtime) / 86400
        info["age_days"] = round(age, 2)
        info["stale"] = ttl_days is not None and age > ttl_days
    return info


def cmd_list(args):
    policy = load_policy()
    items = stored_items()
    for site in sorted(policy["sites"]):
        p = site_policy(policy, site)
        accounts = {}
        for account in accounts_of(site, items):
            have = [f for s, a, f in items if s == site and a == account]
            sess = session_info(site, account, p.get("session_ttl_days"))
            accounts[account] = {
                "stored_fields": have,
                "otp": p["otp"] and TOTP_FIELD in have,
                "session": p["session"] and sess["exists"],
                "session_stale": sess.get("stale"),
            }
        print(json.dumps({"site": site, "domains": p.get("domains", []), "allowed_fields": p["fields"],
                          "otp_allowed": p["otp"], "session_allowed": p["session"], "accounts": accounts},
                         ensure_ascii=False))
    orphans = sorted({s for s, _, _ in items} - set(policy["sites"]))
    if orphans:
        print(f"browser-vault: keyring has entries for unregistered sites: {', '.join(orphans)}", file=sys.stderr)


def host_of(domain):
    domain = domain.strip()
    host = urlparse(domain).hostname if "://" in domain else domain.split("/")[0]
    if not host:
        die(f"invalid domain: {domain}")
    return host.lower()


def union(old, new):
    return old + [x for x in new if x not in old]


def cmd_add(args):
    site, account = parse_ref(args.ref)
    if site in read_toml(POLICY_PATH).get("sites", {}):
        die(f"site '{site}' is hand-written in {POLICY_PATH}; edit it there")
    sites = read_toml(SITES_PATH).get("sites", {})
    created = site not in sites
    entry = dict(sites.get(site, {}))
    domains = [host_of(d) for d in args.domain]
    if created and not domains:
        die("a new site needs at least one --domain (host or URL)")
    entry["domains"] = union(entry.get("domains", []), domains)
    if args.login_url:
        entry["login_url"] = args.login_url
    base_fields = list(DEFAULT_FIELDS) if created else entry.get("fields", [])
    entry["fields"] = union(base_fields, [f for f in args.field if f != TOTP_FIELD])
    if TOTP_FIELD in args.field:
        args.otp = True
    for key in ("otp", "session"):
        if getattr(args, key) is not None:
            entry[key] = getattr(args, key)
    entry.setdefault("otp", False)
    entry.setdefault("session", True)
    if args.session_ttl_days is not None:
        entry["session_ttl_days"] = args.session_ttl_days
    for key in ("confirm", "deny"):
        if getattr(args, key) is not None:
            entry[key] = [a for a in getattr(args, key) if a]
    sites[site] = entry
    write_sites(sites)
    print(f"{'added' if created else 'updated'} site {site} in {SITES_PATH}", file=sys.stderr)

    if args.no_prompt or not sys.stdin.isatty():
        return
    if account is None:
        account = resolve(site)[1]
    have = {f for s, a, f in stored_items() if s == site and a == account}
    for field in entry["fields"] + ([TOTP_FIELD] if entry["otp"] else []):
        hint = "keep current" if field in have else "skip"
        if field == TOTP_FIELD:
            hint += "; base32 seed or otpauth:// URI"
        value = getpass.getpass(f"{site}:{account}/{field} (empty = {hint}): ")
        if value:
            store_field(site, account, field, value)


def cmd_forget(args):
    site, account = parse_ref(args.ref)
    if account:
        keyring("clear", "service", SERVICE, "site", site, "account", account)
        session_path(site, account).unlink(missing_ok=True)
        print(f"forgot account {site}:{account}: stored secrets and saved session removed", file=sys.stderr)
        return
    if site in read_toml(POLICY_PATH).get("sites", {}):
        die(f"site '{site}' is hand-written in {POLICY_PATH}; remove it there")
    sites = read_toml(SITES_PATH).get("sites", {})
    if site not in sites:
        die(f"site '{site}' is not registered")
    del sites[site]
    write_sites(sites)
    keyring("clear", "service", SERVICE, "site", site)
    for path in SESSION_DIR.glob(f"{site}.*.json") if SESSION_DIR.is_dir() else []:
        path.unlink()
    print(f"forgot {site}: policy entry, every account's secrets and saved sessions removed", file=sys.stderr)


def cmd_set(args):
    site, account = resolve(args.ref)
    p = site_policy(load_policy(), site)
    if args.field == TOTP_FIELD and not p["otp"]:
        die(f"sites.{site}.otp is false; enable it with: browser-vault add {site} --otp", EXIT_DENIED)
    if args.field != TOTP_FIELD and args.field not in p["fields"]:
        die(f"field '{args.field}' is not allowed; add it with: browser-vault add {site} --field {args.field}", EXIT_DENIED)
    value = getpass.getpass(f"{site}:{account}/{args.field}: ") if sys.stdin.isatty() else sys.stdin.read().rstrip("\n")
    if not value:
        die("empty value")
    store_field(site, account, args.field, value)


def cmd_get(args):
    site, account = resolve(args.ref)
    p = site_policy(load_policy(), site)
    if args.field == TOTP_FIELD:
        die(f"the TOTP seed is never printed; use: browser-vault otp {site}:{account}", EXIT_DENIED)
    if args.field not in p["fields"]:
        die(f"field '{args.field}' is not allowed by sites.{site}.fields", EXIT_DENIED)
    sys.stdout.write(lookup(site, account, args.field))


def cmd_otp(args):
    site, account = resolve(args.ref)
    if not site_policy(load_policy(), site)["otp"]:
        die(f"sites.{site}.otp is false", EXIT_DENIED)
    code, remaining = totp(lookup(site, account, TOTP_FIELD))
    if remaining < args.min_remaining:
        time.sleep(remaining)
        code, remaining = totp(lookup(site, account, TOTP_FIELD))
    print(code)
    print(f"valid for {remaining}s", file=sys.stderr)


def cmd_rm(args):
    site, account = resolve(args.ref)
    res = keyring("clear", *attrs(site, account, args.field))
    if res.returncode != 0:
        die(res.stderr.strip() or "secret-tool clear failed")
    print(f"removed {site}:{account}/{args.field}", file=sys.stderr)


def cmd_session(args):
    site, account = resolve(args.ref)
    p = site_policy(load_policy(), site)
    if not p["session"]:
        die(f"sites.{site}.session is false", EXIT_DENIED)
    SESSION_DIR.mkdir(parents=True, exist_ok=True)
    os.chmod(DATA_DIR, 0o700)
    os.chmod(SESSION_DIR, 0o700)
    path = session_path(site, account)
    if args.action == "rm":
        path.unlink(missing_ok=True)
        print(f"removed {path}", file=sys.stderr)
        return
    if args.action == "seal" and path.exists():
        os.chmod(path, 0o600)
    print(json.dumps(session_info(site, account, p.get("session_ttl_days")), ensure_ascii=False))


def cmd_policy(args):
    policy = load_policy()
    if args.site:
        print(json.dumps(site_policy(policy, parse_ref(args.site)[0]), ensure_ascii=False, indent=2))
    else:
        print(json.dumps(policy, ensure_ascii=False, indent=2))


def cmd_check(args):
    p = site_policy(load_policy(), parse_ref(args.site)[0])
    if args.action in p["deny"]:
        print("deny")
        sys.exit(EXIT_DENIED)
    if args.action in p["confirm"]:
        print("confirm")
        sys.exit(EXIT_CONFIRM)
    print("allow")


def main():
    ap = argparse.ArgumentParser(prog="browser-vault", description=__doc__.splitlines()[0])
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("list", help="sites, accounts, allowed/stored fields, otp and session state (no values)").set_defaults(fn=cmd_list)

    p = sub.add_parser("add", help="register or update a site, then prompt for an account's secrets (no TOML editing)")
    p.add_argument("ref", metavar="SITE[:ACCOUNT]")
    p.add_argument("--domain", action="append", default=[], help="host or URL credentials may be typed into (repeatable)")
    p.add_argument("--login-url")
    p.add_argument("--field", action="append", default=[],
                   help=f"extra allowed field (repeatable; new sites start with {', '.join(DEFAULT_FIELDS)}; 'totp' implies --otp)")
    p.add_argument("--otp", action=argparse.BooleanOptionalAction, default=None, help="allow TOTP codes")
    p.add_argument("--session", action=argparse.BooleanOptionalAction, default=None, help="allow saved sessions (default on)")
    p.add_argument("--session-ttl-days", type=int)
    p.add_argument("--confirm", nargs="*", help="replace the actions needing user confirmation (default: policy.toml defaults)")
    p.add_argument("--deny", nargs="*", help="replace the denied actions")
    p.add_argument("--no-prompt", action="store_true", help="only update the site entry")
    p.set_defaults(fn=cmd_add)

    p = sub.add_parser("forget", help="SITE: remove the site, all accounts and sessions; SITE:ACCOUNT: remove one account")
    p.add_argument("ref", metavar="SITE[:ACCOUNT]")
    p.set_defaults(fn=cmd_forget)

    for name, fn, hlp in (("set", cmd_set, "store one field from stdin or a hidden prompt"),
                          ("get", cmd_get, "print a field allowed by policy"),
                          ("rm", cmd_rm, "delete a stored field")):
        p = sub.add_parser(name, help=hlp)
        p.add_argument("ref", metavar="SITE[:ACCOUNT]")
        p.add_argument("field")
        p.set_defaults(fn=fn)

    p = sub.add_parser("otp", help="print the current TOTP code")
    p.add_argument("ref", metavar="SITE[:ACCOUNT]")
    p.add_argument("--min-remaining", type=int, default=5, help="wait for the next code if fewer seconds are left")
    p.set_defaults(fn=cmd_otp)

    p = sub.add_parser("session", help="session file path/state; 'seal' chmods it 600 after tab.saveState")
    p.add_argument("action", choices=["info", "seal", "rm"])
    p.add_argument("ref", metavar="SITE[:ACCOUNT]")
    p.set_defaults(fn=cmd_session)

    p = sub.add_parser("policy", help="print the merged policy")
    p.add_argument("site", nargs="?")
    p.set_defaults(fn=cmd_policy)

    p = sub.add_parser("check", help=f"allow (0) / confirm ({EXIT_CONFIRM}) / deny ({EXIT_DENIED}) for an action")
    p.add_argument("site")
    p.add_argument("action")
    p.set_defaults(fn=cmd_check)

    args = ap.parse_args()
    args.fn(args)


if __name__ == "__main__":
    main()
