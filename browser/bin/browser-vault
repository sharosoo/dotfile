#!/usr/bin/env python3
"""Local credentials, TOTP and saved browser sessions for coding agents.

Secrets live in the GNOME keyring (libsecret, unlocked at login), never in files
or dotfiles. Which site/field an agent may read is decided by policy.toml
(hand-written defaults) plus sites.toml (written by `browser-vault add`).
A site can hold several accounts, addressed as SITE:ACCOUNT (e.g. google:work);
plain SITE means its only account, or "default" when none is stored yet.
Session files are Playwright-style storageState JSON written by omp's
`tab.saveState(path)` and restored with `tab.loadState(path)`.
"""

import argparse
import base64
import fcntl
import getpass
import hashlib
import hmac
import json
import os
import re
import secrets
import struct
import subprocess
import sys
import time
import tomllib
from pathlib import Path
from urllib.parse import parse_qs, unquote, urlparse, urlsplit

SERVICE = "sharosoo-browser"
CONFIG_DIR = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "sharosoo-browser"
DATA_DIR = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share")) / "sharosoo-browser"
POLICY_PATH = Path(os.environ.get("BROWSER_VAULT_POLICY", CONFIG_DIR / "policy.toml"))
SITES_PATH = Path(os.environ.get("BROWSER_VAULT_SITES", CONFIG_DIR / "sites.toml"))
SESSION_DIR = DATA_DIR / "sessions"
ENROLL_LOG = DATA_DIR / "otp-enroll.log"
# No '.' or ':' so "SITE:ACCOUNT" refs and "SITE.ACCOUNT.json" session names stay unambiguous.
NAME = re.compile(r"^[a-z0-9][a-z0-9_-]*$")
DEFAULT_ACCOUNT = "default"
DEFAULT_FIELDS = ["username", "password"]
TOTP_FIELD = "totp"
TOTP_ALGORITHMS = ("SHA1", "SHA256", "SHA512")
BASE32 = re.compile(r"^[A-Z2-7]+=*$")
# RFC 4226 §4 requires at least 128-bit shared secrets; some sites still issue 80-bit ones.
MIN_SEED_BYTES = 10
# http is only accepted for loopback dev servers; anything else must be https.
LOOPBACK_HOSTS = {"localhost", "127.0.0.1", "::1"}
ENROLL_MODES = ("confirm", "auto")

EXIT_DENIED = 4
EXIT_CONFIRM = 3
LOCK_WAIT_SECONDS = 30


def die(msg, code=1):
    print(f"browser-vault: {msg}", file=sys.stderr)
    sys.exit(code)


# --- policy -------------------------------------------------------------------

def read_toml(path):
    if not path.exists():
        return {}
    with path.open("rb") as f:
        return tomllib.load(f)


def load_policy():
    if not POLICY_PATH.exists():
        die(f"policy file missing: {POLICY_PATH} (run dotfile/browser/install.sh)")
    policy = read_toml(POLICY_PATH)
    policy.setdefault("defaults", {})
    policy.setdefault("sites", {})
    managed = read_toml(SITES_PATH).get("sites", {})
    clash = set(managed) & set(policy["sites"])
    if clash:
        die(f"site(s) defined in both {POLICY_PATH} and {SITES_PATH}: {', '.join(sorted(clash))}")
    policy["sites"].update(managed)
    return policy


def site_policy(policy, site):
    if site not in policy["sites"]:
        die("site is not registered (name not shown); see `browser-vault list`, the user adds it with: "
            "browser-vault add <site> --domain <host>", EXIT_DENIED)
    merged = dict(policy["defaults"])
    merged.update(policy["sites"][site])
    for key, default in (("fields", []), ("otp", False), ("otp_replace", False), ("otp_enroll", "confirm"),
                         ("ignore_port", False), ("session", False), ("confirm", []), ("deny", [])):
        merged.setdefault(key, default)
    return merged


def toml_value(v):
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, int):
        return str(v)
    if isinstance(v, list):
        return "[" + ", ".join(toml_value(x) for x in v) + "]"
    # JSON string escapes (\", \\, \uXXXX) are valid TOML basic-string escapes.
    return json.dumps(str(v), ensure_ascii=False)


def write_sites(sites):
    lines = ["# Generated by `browser-vault add` / `browser-vault forget`. Edit with the CLI;",
             "# hand-written defaults and comments belong in policy.toml.", ""]
    for name in sorted(sites):
        lines.append(f"[sites.{name}]")
        lines += [f"{k} = {toml_value(v)}" for k, v in sites[name].items()]
        lines.append("")
    # Write through the symlink so the dotfile copy is what changes.
    target = SITES_PATH.resolve()
    tmp = target.with_suffix(".tmp")
    tmp.write_text("\n".join(lines), encoding="utf-8")
    tmp.replace(target)


# --- keyring ------------------------------------------------------------------

def keyring(*args, stdin=None):
    try:
        return subprocess.run(["secret-tool", *args], input=stdin, capture_output=True, text=True)
    except FileNotFoundError:
        die("secret-tool not found (install libsecret)")


def attrs(site, account, field):
    return ["service", SERVICE, "site", site, "account", account, "field", field]


def stored_items():
    """(site, account, field) for every stored secret.

    Attributes go to stderr while item headers, labels and secrets go to stdout, so
    blocks cannot be reassembled; the label written by store_field
    ("<service> <site> <account> <field>") identifies an item. Secret lines are read
    but never kept.
    """
    res = subprocess.run(["secret-tool", "search", "--all", "service", SERVICE],
                         stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
    found = set()
    for line in res.stdout.splitlines():
        if not line.startswith("label = "):
            continue
        parts = line.removeprefix("label = ").split(" ")
        if len(parts) == 4 and parts[0] == SERVICE:
            found.add(tuple(parts[1:]))
    return sorted(found)


def keyring_lookup(site, account, field):
    """The stored secret, or None when confirmed absent. Anything else dies, so callers fail closed."""
    res = keyring("lookup", *attrs(site, account, field))
    if res.returncode == 0 and res.stdout:
        return res.stdout
    # `lookup` exits 1 both for "no such item" and for D-Bus/keyring failures, so absence is only
    # accepted when `search` on the same attributes succeeds (exit 0) and lists no item.
    if res.returncode == 1 and not res.stdout and not res.stderr.strip():
        probe = subprocess.run(["secret-tool", "search", "--all", *attrs(site, account, field)],
                               stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
        if probe.returncode == 0 and not any(l.startswith("label = ") for l in probe.stdout.splitlines()):
            return None
    die(f"keyring error: {res.stderr.strip() or f'secret-tool lookup exit {res.returncode}'}")


def lookup(site, account, field):
    value = keyring_lookup(site, account, field)
    if value is None:
        die(f"no {field} stored for that account of site {site} (account not shown); "
            f"the user stores it with: browser-vault set {site}:<account> {field}")
    return value


def store_field(site, account, field, value):
    if field == TOTP_FIELD:
        try:
            totp(value)
        except Exception as e:  # noqa: BLE001 - any parse failure means a bad seed
            die(f"invalid TOTP seed or otpauth URI: {e}")
    res = keyring("store", f"--label={SERVICE} {site} {account} {field}", *attrs(site, account, field), stdin=value)
    if res.returncode != 0:
        die(res.stderr.strip() or "secret-tool store failed")
    print(f"stored {site}:{account}/{field}", file=sys.stderr)


# --- accounts -----------------------------------------------------------------

def session_path(site, account):
    return SESSION_DIR / f"{site}.{account}.json"


def accounts_of(site, items=None):
    found = {a for s, a, _ in (items if items is not None else stored_items()) if s == site}
    if SESSION_DIR.is_dir():
        found |= {p.name.split(".")[1] for p in SESSION_DIR.glob(f"{site}.*.json")}
    return sorted(found)


def parse_ref(ref):
    site, _, account = ref.partition(":")
    if not NAME.match(site) or (account and not NAME.match(account)):
        die("bad reference (not shown): use SITE or SITE:ACCOUNT (lowercase letters, digits, '-', '_')")
    return site, account or None


def resolve(ref):
    """SITE[:ACCOUNT] -> (site, account). A bare site resolves to its only account."""
    site, account = parse_ref(ref)
    if account:
        return site, account
    accounts = accounts_of(site)
    if len(accounts) > 1:
        die(f"site '{site}' has several accounts ({', '.join(accounts)}); use {site}:<account>")
    return site, accounts[0] if accounts else DEFAULT_ACCOUNT


# --- TOTP ---------------------------------------------------------------------

def parse_totp(raw):
    """Validate a base32 seed or otpauth://totp URI. Error messages never contain input values."""
    raw = raw.strip()
    params = {"digits": 6, "period": 30, "algorithm": "SHA1"}
    if raw.startswith("otpauth://"):
        url = urlparse(raw)
        if url.netloc.lower() != "totp":
            raise ValueError("otpauth type is not totp")
        q = parse_qs(url.query)
        if "secret" not in q:
            raise ValueError("otpauth URI has no secret parameter")
        secret = q["secret"][0]
        for key in ("digits", "period"):
            if key in q:
                if not q[key][0].isdigit():
                    raise ValueError(f"{key} is not a number")
                params[key] = int(q[key][0])
        if "algorithm" in q:
            params["algorithm"] = q["algorithm"][0].upper()
    else:
        secret = raw
    # Sites print the manual-entry key in space-separated groups.
    secret = "".join(unquote(secret).split()).upper()
    if not BASE32.match(secret):
        raise ValueError("secret is not base32 (A-Z, 2-7)")
    if params["digits"] not in (6, 7, 8):
        raise ValueError("digits must be 6, 7 or 8")
    if not 1 <= params["period"] <= 300:
        raise ValueError("period must be 1-300 seconds")
    if params["algorithm"] not in TOTP_ALGORITHMS:
        raise ValueError(f"algorithm must be one of {', '.join(TOTP_ALGORITHMS)}")
    secret = secret.rstrip("=")
    key = base64.b32decode(secret + "=" * (-len(secret) % 8))
    if len(key) < MIN_SEED_BYTES:
        raise ValueError(f"secret is only {len(key) * 8} bits (expected at least {MIN_SEED_BYTES * 8})")
    return key, params


def otpauth_identity(raw):
    """(issuer, account) named by an otpauth URI label/issuer parameter; (None, None) for a bare seed.

    Dies when the label prefix and the issuer parameter disagree, since one of them is then forged.
    """
    if not raw.startswith("otpauth://"):
        return None, None
    url = urlparse(raw)
    label = unquote(url.path.lstrip("/")).strip()
    prefix, sep, account = label.partition(":")
    if not sep:
        prefix, account = "", label
    issuer = parse_qs(url.query).get("issuer", [""])[0].strip()
    prefix = prefix.strip()
    if issuer and prefix and issuer.casefold() != prefix.casefold():
        die("otpauth URI issuer parameter and label prefix disagree", EXIT_DENIED)
    return (issuer or prefix or None), (account.strip() or None)


def totp(raw, now=None):
    key, p = parse_totp(raw)
    now = now if now is not None else time.time()
    counter = int(now // p["period"])
    digest = hmac.new(key, struct.pack(">Q", counter), getattr(hashlib, p["algorithm"].lower())).digest()
    offset = digest[-1] & 0x0F
    code = (struct.unpack(">I", digest[offset:offset + 4])[0] & 0x7FFFFFFF) % 10 ** p["digits"]
    remaining = p["period"] - int(now) % p["period"]
    return str(code).zfill(p["digits"]), remaining


# --- commands -----------------------------------------------------------------

def session_info(site, account, ttl_days):
    path = session_path(site, account)
    info = {"site": site, "account": account, "path": str(path), "exists": path.exists()}
    if path.exists():
        age = (time.time() - path.stat().st_mtime) / 86400
        info["age_days"] = round(age, 2)
        info["stale"] = ttl_days is not None and age > ttl_days
    return info


def cmd_list(args):
    policy = load_policy()
    items = stored_items()
    for site in sorted(policy["sites"]):
        p = site_policy(policy, site)
        accounts = {}
        for account in accounts_of(site, items):
            have = [f for s, a, f in items if s == site and a == account]
            sess = session_info(site, account, p.get("session_ttl_days"))
            accounts[account] = {
                "stored_fields": have,
                "otp": p["otp"] and TOTP_FIELD in have,
                "session": p["session"] and sess["exists"],
                "session_stale": sess.get("stale"),
            }
        print(json.dumps({"site": site, "domains": p.get("domains", []), "allowed_fields": p["fields"],
                          "otp_allowed": p["otp"], "session_allowed": p["session"], "accounts": accounts},
                         ensure_ascii=False))
    orphans = sorted({s for s, _, _ in items} - set(policy["sites"]))
    if orphans:
        print(f"browser-vault: keyring has entries for unregistered sites: {', '.join(orphans)}", file=sys.stderr)


def norm_host(host):
    """Lowercase, drop a trailing dot and convert IDNs to ASCII so equal hosts compare equal."""
    host = host.strip().rstrip(".").lower()
    try:
        host = host.encode("idna").decode("ascii")
    except UnicodeError:
        die("invalid host name (not shown)")
    if not host:
        die("empty host name")
    return host


def split_hostport(entry):
    """'host', 'host:port', '[v6]:port' or a URL -> (normalized host, port or None)."""
    entry = entry.strip()
    try:
        u = urlsplit(entry if "://" in entry else f"//{entry}")
        host, port = u.hostname, u.port
    except ValueError:
        die("invalid host or port (not shown)")
    if not host:
        die("invalid host (not shown)")
    return norm_host(host), port


def host_of(domain):
    host, port = split_hostport(domain)
    host = f"[{host}]" if ":" in host else host
    return f"{host}:{port}" if port is not None else host


def default_port(scheme):
    return 443 if scheme == "https" else 80


def page_allowed(origin, p):
    """Normalized host:port of a page origin if the site policy allows it; dies (without echoing it) otherwise.

    Only an origin (scheme://host[:port], optional trailing '/') is accepted, so paths and query
    tokens never reach argv. Domain entries match exactly; '*.example.com' matches subdomains only.
    An entry without a port means the scheme's default port unless the site sets ignore_port = true.
    """
    try:
        u = urlsplit(origin.strip())
        port = u.port
    except ValueError:
        die("--host is not a valid URL (not shown)", EXIT_DENIED)
    if u.scheme not in ("https", "http") or not u.hostname:
        die("--host must be the page's https origin (new URL(tab.url()).origin)", EXIT_DENIED)
    if u.path not in ("", "/") or u.query or u.fragment or "?" in origin or "#" in origin:
        die("--host must be an origin only: no path, query or fragment", EXIT_DENIED)
    if u.username is not None or u.password is not None:
        die("--host URL must not contain user info", EXIT_DENIED)
    host = norm_host(u.hostname)
    if u.scheme == "http" and host not in LOOPBACK_HOSTS:
        die("--host must be https (http only for localhost)", EXIT_DENIED)
    if port is None:
        port = default_port(u.scheme)
    for entry in p.get("domains", []):
        ehost, eport = split_hostport(entry)
        if ehost.startswith("*."):
            host_ok = host.endswith(ehost[1:]) and host != ehost[2:]
        else:
            host_ok = host == ehost
        port_ok = p["ignore_port"] or (eport if eport is not None else default_port(u.scheme)) == port
        if host_ok and port_ok:
            return f"{host}:{port}"
    die("the page host is not in this site's domains (not shown)", EXIT_DENIED)


def union(old, new):
    return old + [x for x in new if x not in old]


def cmd_add(args):
    vault_lock()
    site, account = parse_ref(args.ref)
    if site in read_toml(POLICY_PATH).get("sites", {}):
        die(f"site '{site}' is hand-written in {POLICY_PATH}; edit it there")
    sites = read_toml(SITES_PATH).get("sites", {})
    created = site not in sites
    entry = dict(sites.get(site, {}))
    domains = [host_of(d) for d in args.domain]
    if created and not domains:
        die("a new site needs at least one --domain (host or URL)")
    entry["domains"] = union(entry.get("domains", []), domains)
    if args.login_url:
        entry["login_url"] = args.login_url
    base_fields = list(DEFAULT_FIELDS) if created else entry.get("fields", [])
    entry["fields"] = union(base_fields, [f for f in args.field if f != TOTP_FIELD])
    if TOTP_FIELD in args.field:
        args.otp = True
    for key in ("otp", "otp_replace", "otp_enroll", "otp_issuer", "ignore_port", "session"):
        if getattr(args, key) == "":
            entry.pop(key, None)
        elif getattr(args, key) is not None:
            entry[key] = getattr(args, key)
    entry.setdefault("otp", False)
    entry.setdefault("session", True)
    if args.session_ttl_days is not None:
        entry["session_ttl_days"] = args.session_ttl_days
    for key in ("confirm", "deny"):
        if getattr(args, key) is not None:
            entry[key] = [a for a in getattr(args, key) if a]
    sites[site] = entry
    write_sites(sites)
    print(f"{'added' if created else 'updated'} site {site} in {SITES_PATH}", file=sys.stderr)

    if args.no_prompt or not sys.stdin.isatty():
        return
    if account is None:
        account = resolve(site)[1]
    have = {f for s, a, f in stored_items() if s == site and a == account}
    for field in entry["fields"] + ([TOTP_FIELD] if entry["otp"] else []):
        hint = "keep current" if field in have else "skip"
        if field == TOTP_FIELD:
            hint += "; base32 seed or otpauth:// URI"
        value = getpass.getpass(f"{site}:{account}/{field} (empty = {hint}): ")
        if value:
            store_field(site, account, field, value)


def cmd_forget(args):
    vault_lock()
    site, account = parse_ref(args.ref)
    if account:
        keyring("clear", "service", SERVICE, "site", site, "account", account)
        session_path(site, account).unlink(missing_ok=True)
        print(f"forgot account {site}:{account}: stored secrets and saved session removed", file=sys.stderr)
        return
    if site in read_toml(POLICY_PATH).get("sites", {}):
        die(f"site '{site}' is hand-written in {POLICY_PATH}; remove it there")
    sites = read_toml(SITES_PATH).get("sites", {})
    if site not in sites:
        die("site is not registered (name not shown)")
    del sites[site]
    write_sites(sites)
    keyring("clear", "service", SERVICE, "site", site)
    for path in SESSION_DIR.glob(f"{site}.*.json") if SESSION_DIR.is_dir() else []:
        path.unlink()
    print(f"forgot {site}: policy entry, every account's secrets and saved sessions removed", file=sys.stderr)


def cmd_set(args):
    vault_lock()
    site, account = resolve(args.ref)
    p = site_policy(load_policy(), site)
    if args.field == TOTP_FIELD and not p["otp"]:
        die(f"sites.{site}.otp is false; enable it with: browser-vault add {site} --otp", EXIT_DENIED)
    if args.field != TOTP_FIELD and args.field not in p["fields"]:
        die(f"field not allowed (not shown); the user adds it with: browser-vault add {site} --field <field>", EXIT_DENIED)
    value = getpass.getpass(f"{site}:{account}/{args.field}: ") if sys.stdin.isatty() else sys.stdin.read().rstrip("\n")
    if not value:
        die("empty value")
    store_field(site, account, args.field, value)


def cmd_get(args):
    site, account = resolve(args.ref)
    p = site_policy(load_policy(), site)
    if args.field == TOTP_FIELD:
        die(f"the TOTP seed is never printed; use: browser-vault otp {site}:{account}", EXIT_DENIED)
    if args.field not in p["fields"]:
        die(f"field not allowed by sites.{site}.fields (not shown)", EXIT_DENIED)
    sys.stdout.write(lookup(site, account, args.field))


def cmd_otp(args):
    site, account = resolve(args.ref)
    if not site_policy(load_policy(), site)["otp"]:
        die(f"sites.{site}.otp is false", EXIT_DENIED)
    code, remaining = totp(lookup(site, account, TOTP_FIELD))
    if remaining < args.min_remaining:
        time.sleep(remaining)
        code, remaining = totp(lookup(site, account, TOTP_FIELD))
    print(code)
    print(f"valid for {remaining}s", file=sys.stderr)


def open_data_dir():
    """fd of DATA_DIR (created 0700). A symlinked DATA_DIR is refused so the audit log cannot be redirected."""
    DATA_DIR.parent.mkdir(parents=True, exist_ok=True)
    try:
        os.mkdir(DATA_DIR, 0o700)
    except FileExistsError:
        pass
    try:
        dfd = os.open(DATA_DIR, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
    except OSError:
        die(f"{DATA_DIR} must be a real directory, not a symlink", EXIT_DENIED)
    os.fchmod(dfd, 0o700)
    return dfd


def open_private(dfd, name, flags):
    try:
        fd = os.open(name, flags | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600, dir_fd=dfd)
    except OSError as e:
        die(f"cannot open {DATA_DIR / name} ({e.strerror}); refusing to continue", EXIT_DENIED)
    os.fchmod(fd, 0o600)
    return fd


_lock_fd = None


def vault_lock():
    """Hold the vault-wide lock until exit; returns the DATA_DIR fd.

    Every command that changes secrets or sites.toml takes it before reading policy, so a policy
    or seed check cannot go stale before the write it guards.
    """
    global _lock_fd
    dfd = open_data_dir()
    _lock_fd = open_private(dfd, ".vault.lock", os.O_RDWR)
    deadline = time.monotonic() + LOCK_WAIT_SECONDS
    while True:
        try:
            fcntl.flock(_lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return dfd
        except BlockingIOError:
            if time.monotonic() > deadline:
                die(f"another browser-vault command holds the vault lock for over {LOCK_WAIT_SECONDS}s; retry later")
            time.sleep(0.2)


def audit_write(fd, entry):
    """Append one JSON line and fsync it; returns the OSError on failure."""
    data = (json.dumps(entry, ensure_ascii=False) + "\n").encode()
    try:
        if os.write(fd, data) != len(data):
            raise OSError(0, "short write")
        os.fsync(fd)
    except OSError as e:
        return e
    return None


# Second-level labels that are public suffixes under two-letter ccTLDs (co.kr, com.au, ac.jp, ...);
# no public-suffix list is installed, so this covers the common registries.
SUFFIX_SECOND_LEVEL = {"co", "com", "net", "org", "ac", "go", "or", "ne", "gov", "edu", "mil", "gv", "re", "pe", "ltd", "plc"}


def registrable_label(host):
    """The label left of the public suffix (github in api.github.com, example in www.example.co.kr), else None."""
    host = host.removeprefix("*.")
    if ":" in host or re.fullmatch(r"[\d.]+", host):
        return None
    labels = host.split(".")
    index = 3 if len(labels[-1]) == 2 and len(labels) >= 3 and labels[-2] in SUFFIX_SECOND_LEVEL else 2
    if len(labels) < index:
        return None
    label = labels[-index]
    return None if label in SUFFIX_SECOND_LEVEL or len(label) < 2 else label


def issuer_token(issuer):
    """Issuer as a comparable DNS label: 'GitHub' -> 'github', 'Bücher' -> 'xn--bcher-kva'."""
    token = "".join(issuer.casefold().split())
    try:
        token = token.encode("idna").decode("ascii")
    except UnicodeError:
        return None
    token = re.sub(r"[^a-z0-9-]", "", token)
    return token or None


def check_identity(raw, site, account, p, known_ids, confirmed):
    """Refuse an otpauth URI whose issuer or account label points at a different site or account.

    otp_enroll = "auto" only covers input that proves both: an issuer matching the site and an
    account label matching the stored username/email. Anything less (bare base32, no issuer, no
    label, no stored username/email) needs the user's --confirmed.
    """
    issuer, label_account = otpauth_identity(raw)
    expected = p.get("otp_issuer")
    if issuer is None:
        if expected and raw.startswith("otpauth://"):
            die(f"the otpauth URI names no issuer but sites.{site}.otp_issuer is set", EXIT_DENIED)
    else:
        if expected:
            ok = issuer.casefold() == expected.casefold()
        else:
            token = issuer_token(issuer)
            ok = token is not None and token in {registrable_label(split_hostport(d)[0]) for d in p.get("domains", [])}
        if not ok:
            die(f"the otpauth issuer does not match site {site} (not shown); if it is right, the user sets it with: "
                f"browser-vault add {site} --otp-issuer <issuer>", EXIT_DENIED)
    if label_account and known_ids and label_account.casefold() not in {v.strip().casefold() for v in known_ids}:
        die("the otpauth account label does not match this account's stored username/email (not shown)", EXIT_DENIED)
    if not confirmed and not (issuer and label_account and known_ids):
        die(f"the input does not prove both site and account (needs an otpauth URI with a matching issuer and "
            f"account label), so the user must approve enrolling {site}:{account}: ask, then rerun with --confirmed",
            EXIT_CONFIRM)


def cmd_otp_enroll(args):
    if args.secret:
        die("never pass a TOTP secret as an argument (argv is visible in ps, shell history and transcripts); "
            "pipe it on stdin. Treat that key as exposed: restart the site's 2FA setup to get a new one.", EXIT_DENIED)
    dfd = vault_lock()
    site, account = resolve(args.ref)
    p = site_policy(load_policy(), site)
    if not p["otp"]:
        die(f"sites.{site}.otp is false; only the user can enable it: browser-vault add {site} --otp", EXIT_DENIED)
    if p["otp_enroll"] not in ENROLL_MODES:
        die(f"sites.{site}.otp_enroll must be one of {', '.join(ENROLL_MODES)}")
    # Enrolling binds an account to a seed only this machine holds, so it is limited to accounts the user stored.
    known_ids, registered = [], False
    for field in p["fields"]:
        value = keyring_lookup(site, account, field)
        registered = registered or value is not None
        if value is not None and field in ("username", "email"):
            known_ids.append(value)
    if not registered:
        die(f"no stored credentials for this account of site {site} (not shown); TOTP is only enrolled for accounts "
            f"the user registered with browser-vault add {site}:<account>", EXIT_DENIED)
    if p["otp_enroll"] == "confirm" and not args.confirmed:
        die(f"enrolling a TOTP seed for {site}:{account} needs the user's OK (sites.{site}.otp_enroll = \"confirm\"): "
            "ask once, then rerun with --confirmed", EXIT_CONFIRM)
    host = page_allowed(args.host, p)
    raw = getpass.getpass(f"{site}:{account}/{TOTP_FIELD} (base32 or otpauth:// URI): ") if sys.stdin.isatty() \
        else sys.stdin.read()
    raw = raw.strip()
    if not raw:
        die("empty input: pipe an otpauth:// URI or base32 secret on stdin")
    try:
        _, params = parse_totp(raw)
    except Exception as e:  # noqa: BLE001 - any parse failure means a bad seed
        die(f"invalid TOTP seed or otpauth URI: {e}")
    check_identity(raw, site, account, p, known_ids, args.confirmed)

    log_fd = open_private(dfd, ENROLL_LOG.name, os.O_WRONLY | os.O_APPEND)
    previous = keyring_lookup(site, account, TOTP_FIELD)
    replacing = previous is not None
    if replacing and not args.replace:
        die(f"{site}:{account} already has a TOTP seed; overwriting it needs --replace", EXIT_DENIED)
    if replacing and not p["otp_replace"]:
        die(f"sites.{site}.otp_replace is false; only the user can allow it: browser-vault add {site} --otp-replace",
            EXIT_DENIED)
    entry = {"id": secrets.token_hex(4), "time": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "site": site,
             "account": account, "host": host, "replaced": replacing, **params}
    if err := audit_write(log_fd, {**entry, "status": "pending"}):
        die(f"cannot write {ENROLL_LOG} ({err.strerror}); nothing stored", EXIT_DENIED)
    label = f"--label={SERVICE} {site} {account} {TOTP_FIELD}"
    res = keyring("store", label, *attrs(site, account, TOTP_FIELD), stdin=raw)
    if res.returncode != 0:
        audit_write(log_fd, {**entry, "status": "failed"})
        die(f"keyring store failed: {res.stderr.strip()}")
    # A stored seed without its `ok` line would be an unaudited change, so the store is undone
    # (previous seed restored, or the new one removed) before anything is typed into the site.
    if err := audit_write(log_fd, {**entry, "status": "ok"}):
        undo = keyring("store", label, *attrs(site, account, TOTP_FIELD), stdin=previous) if replacing \
            else keyring("clear", *attrs(site, account, TOTP_FIELD))
        if undo.returncode != 0:
            die(f"cannot write {ENROLL_LOG} after storing ({err.strerror}) AND the rollback failed "
                f"({undo.stderr.strip()}): the NEW seed is stored for {site}:{account}; tell the user")
        audit_write(log_fd, {**entry, "status": "rolled_back"})
        die(f"cannot write {ENROLL_LOG} after storing ({err.strerror}); rolled back "
            f"({'previous seed restored' if replacing else 'new seed removed'}); do not type a code")
    fcntl.flock(_lock_fd, fcntl.LOCK_UN)
    code, remaining = totp(raw)
    if remaining < args.min_remaining:
        time.sleep(remaining)
        code, remaining = totp(raw)
    print(code)
    print(f"enrolled {site}:{account}; type this code into the setup page to confirm (valid for {remaining}s)",
          file=sys.stderr)


def cmd_rm(args):
    vault_lock()
    site, account = resolve(args.ref)
    res = keyring("clear", *attrs(site, account, args.field))
    if res.returncode != 0:
        die(res.stderr.strip() or "secret-tool clear failed")
    print(f"removed {site}:{account}/{args.field}", file=sys.stderr)


def cmd_session(args):
    site, account = resolve(args.ref)
    p = site_policy(load_policy(), site)
    if not p["session"]:
        die(f"sites.{site}.session is false", EXIT_DENIED)
    SESSION_DIR.mkdir(parents=True, exist_ok=True)
    os.chmod(DATA_DIR, 0o700)
    os.chmod(SESSION_DIR, 0o700)
    path = session_path(site, account)
    if args.action == "rm":
        path.unlink(missing_ok=True)
        print(f"removed {path}", file=sys.stderr)
        return
    if args.action == "seal" and path.exists():
        os.chmod(path, 0o600)
    print(json.dumps(session_info(site, account, p.get("session_ttl_days")), ensure_ascii=False))


def cmd_policy(args):
    policy = load_policy()
    if args.site:
        print(json.dumps(site_policy(policy, parse_ref(args.site)[0]), ensure_ascii=False, indent=2))
    else:
        print(json.dumps(policy, ensure_ascii=False, indent=2))


def cmd_check(args):
    p = site_policy(load_policy(), parse_ref(args.site)[0])
    if args.action in p["deny"]:
        print("deny")
        sys.exit(EXIT_DENIED)
    if args.action in p["confirm"]:
        print("confirm")
        sys.exit(EXIT_CONFIRM)
    print("allow")


class RedactingParser(argparse.ArgumentParser):
    def error(self, message):
        # argparse quotes the offending value ("invalid int value: 'x'", "unrecognized arguments: x");
        # it may be a mistyped secret, so keep only the argument name.
        if message.startswith("unrecognized arguments"):
            message = "unrecognized arguments (not shown: one may be a secret; secrets go on stdin)"
        elif "'" in message:
            message = message.split(":")[0] + ": invalid value (not shown)"
        super().error(message)


def main():
    ap = RedactingParser(prog="browser-vault", description=__doc__.splitlines()[0])
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("list", help="sites, accounts, allowed/stored fields, otp and session state (no values)").set_defaults(fn=cmd_list)

    p = sub.add_parser("add", help="register or update a site, then prompt for an account's secrets (no TOML editing)")
    p.add_argument("ref", metavar="SITE[:ACCOUNT]")
    p.add_argument("--domain", action="append", default=[], help="host or URL credentials may be typed into (repeatable)")
    p.add_argument("--login-url")
    p.add_argument("--field", action="append", default=[],
                   help=f"extra allowed field (repeatable; new sites start with {', '.join(DEFAULT_FIELDS)}; 'totp' implies --otp)")
    p.add_argument("--otp", action=argparse.BooleanOptionalAction, default=None, help="allow TOTP codes")
    p.add_argument("--otp-replace", action=argparse.BooleanOptionalAction, default=None,
                   help="let `otp-enroll --replace` overwrite an existing TOTP seed (default off)")
    p.add_argument("--otp-enroll", choices=ENROLL_MODES,
                   help="confirm (default): agents ask the user before each `otp-enroll`; "
                        "auto: standing permission, only for an otpauth URI whose issuer and account label match")
    p.add_argument("--otp-issuer", help="issuer an enrolled otpauth URI must name "
                                        "(default: the registrable label of a domain; '' removes it)")
    p.add_argument("--ignore-port", action=argparse.BooleanOptionalAction, default=None,
                   help="match domains on host only, any port (default off)")
    p.add_argument("--session", action=argparse.BooleanOptionalAction, default=None, help="allow saved sessions (default on)")
    p.add_argument("--session-ttl-days", type=int)
    p.add_argument("--confirm", nargs="*", help="replace the actions needing user confirmation (default: policy.toml defaults)")
    p.add_argument("--deny", nargs="*", help="replace the denied actions")
    p.add_argument("--no-prompt", action="store_true", help="only update the site entry")
    p.set_defaults(fn=cmd_add)

    p = sub.add_parser("forget", help="SITE: remove the site, all accounts and sessions; SITE:ACCOUNT: remove one account")
    p.add_argument("ref", metavar="SITE[:ACCOUNT]")
    p.set_defaults(fn=cmd_forget)

    for name, fn, hlp in (("set", cmd_set, "store one field from stdin or a hidden prompt"),
                          ("get", cmd_get, "print a field allowed by policy"),
                          ("rm", cmd_rm, "delete a stored field")):
        p = sub.add_parser(name, help=hlp)
        p.add_argument("ref", metavar="SITE[:ACCOUNT]")
        p.add_argument("field")
        p.set_defaults(fn=fn)

    p = sub.add_parser("otp", help="print the current TOTP code")
    p.add_argument("ref", metavar="SITE[:ACCOUNT]")
    p.add_argument("--min-remaining", type=int, default=5, help="wait for the next code if fewer seconds are left")
    p.set_defaults(fn=cmd_otp)

    p = sub.add_parser("otp-enroll", help="store a TOTP seed read from stdin during a site's 2FA setup, print the current code")
    p.add_argument("ref", metavar="SITE[:ACCOUNT]")
    # Only exists to refuse a secret passed on the command line instead of failing with argparse's echo.
    p.add_argument("secret", nargs="*", help=argparse.SUPPRESS)
    p.add_argument("--host", required=True,
                   help="origin of the page showing the setup key (new URL(tab.url()).origin; no path or query)")
    p.add_argument("--replace", action="store_true", help="overwrite an existing seed (site needs otp_replace = true)")
    p.add_argument("--confirmed", action="store_true",
                   help="the user approved this enrollment (needed unless otp_enroll = \"auto\" and the input is an "
                        "otpauth URI whose issuer and account label match)")
    p.add_argument("--min-remaining", type=int, default=5, help="wait for the next code if fewer seconds are left")
    p.set_defaults(fn=cmd_otp_enroll)

    p = sub.add_parser("session", help="session file path/state; 'seal' chmods it 600 after tab.saveState")
    p.add_argument("action", choices=["info", "seal", "rm"])
    p.add_argument("ref", metavar="SITE[:ACCOUNT]")
    p.set_defaults(fn=cmd_session)

    p = sub.add_parser("policy", help="print the merged policy")
    p.add_argument("site", nargs="?")
    p.set_defaults(fn=cmd_policy)

    p = sub.add_parser("check", help=f"allow (0) / confirm ({EXIT_CONFIRM}) / deny ({EXIT_DENIED}) for an action")
    p.add_argument("site")
    p.add_argument("action")
    p.set_defaults(fn=cmd_check)

    args = ap.parse_args()
    args.fn(args)


if __name__ == "__main__":
    main()
