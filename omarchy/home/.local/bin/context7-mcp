#!/usr/bin/env bash
# Context7 MCP server (stdio) with the API key read from the GNOME keyring, so editor
# settings in the dotfile repo never hold it. Store the key once with:
#   secret-tool store --label="Context7 API key" service context7 field api-key
# On macOS the key lives in the login Keychain instead:
#   security add-generic-password -s context7 -a api-key -w <key>
# Without a stored key the server still runs, at Context7's anonymous rate limit.
set -euo pipefail
export PATH="$HOME/.local/share/mise/shims:$PATH"
if [[ "$(uname -s)" == "Darwin" ]]; then
  key=$(security find-generic-password -s context7 -a api-key -w 2>/dev/null || true)
else
  key=$(secret-tool lookup service context7 field api-key 2>/dev/null || true)
fi
exec npx -y @upstash/context7-mcp ${key:+--api-key "$key"} "$@"
