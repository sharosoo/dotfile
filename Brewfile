# Brewfile for Dotfiles
# This file is managed by dotfiles - https://github.com/sharosoo/dotfile
#
# Install with: brew bundle

# Core Tools
brew "git"
brew "curl"
brew "wget"
brew "jq"
brew "htop"
brew "tree"

# Modern CLI Tools
brew "eza"          # Modern replacement for ls
brew "bat"          # Cat with syntax highlighting
brew "fish"         # Fish shell
brew "ripgrep"      # Fast grep alternative
brew "fd"           # Fast find alternative
brew "fzf"          # Fuzzy finder
brew "zoxide"       # Smart cd command
brew "tldr"         # Simplified man pages
brew "dust"         # Modern du
brew "duf"          # Modern df
brew "procs"        # Modern ps
brew "sd"           # Modern sed
brew "httpie"       # Modern curl
brew "starship"     # Shell prompt

# Development Tools
brew "neovim"
brew "tmux"
brew "gh"           # GitHub CLI
brew "glab"         # GitLab CLI
brew "lazygit"      # Terminal UI for git
brew "tig"          # Text interface for git
brew "git-delta"    # Better git diffs

# Language Support
# Runtimes (node, go, rust, python, ruby, uv, pnpm) live in mise: mise/config.toml
