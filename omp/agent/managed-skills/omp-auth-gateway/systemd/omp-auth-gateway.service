[Unit]
Description=omp auth-gateway: OpenAI/Anthropic-compatible proxy on the omp auth-broker (omp-auth-gateway skill)
After=omp-auth-broker.service
Requires=omp-auth-broker.service

[Service]
Type=simple
# Only this unit runs in broker mode; interactive omp sessions keep reading agent.db directly.
Environment=OMP_AUTH_BROKER_URL=http://127.0.0.1:8765
ExecStartPre=/bin/sh -c 'for i in $(seq 30); do curl -fs http://127.0.0.1:8765/v1/healthz >/dev/null && exit 0; sleep 1; done; exit 1'
ExecStart=%h/.local/share/mise/installs/github-can1357-oh-my-pi/latest/omp auth-gateway serve --bind=127.0.0.1:4000
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
