{
  "$schema": "https://raw.githubusercontent.com/can1357/oh-my-pi/main/packages/coding-agent/src/config/mcp-schema.json",
  "mcpServers": {
    "artifact-hub": {
      "type": "http",
      "url": "https://artifact.sharosoo.com/mcp",
      "headers": {
        "Authorization": "Bearer ${ARTIFACT_HUB_TOKEN}"
      }
    },
    "context7": {
      "type": "http",
      "url": "http://127.0.0.1:18170/mcp"
    },
    "deepwiki": {
      "type": "http",
      "url": "https://mcp.deepwiki.com/mcp"
    },
    "devin": {
      "type": "http",
      "url": "https://mcp.devin.ai/mcp",
      "headers": {
        "Authorization": "Bearer ${DEVIN_TOKEN}"
      }
    }
  },
  "disabledServers": [
    "posthog:posthog",
    "sentry:sentry"
  ]
}
